# SiteProof environment. Copy to .env.local for development. Never commit real values.

# Public base URL; also used in the crawler's user agent: SiteProofBot/1.0 (+$APP_URL/bot)
APP_URL=http://localhost:3001

# pglite:./.data/siteproof (local, no Docker), pglite:memory (tests) or postgres://user:pass@host:5432/db (production)
DATABASE_URL=pglite:./.data/siteproof

# Header set by YOUR reverse proxy with the client IP, e.g. x-forwarded-for, fly-client-ip, cf-connecting-ip.
# Leave unset when there is no trusted proxy: all anonymous clients then share one rate-limit bucket (safe default).
# TRUSTED_IP_HEADER=x-forwarded-for

# Abuse limits
SCAN_RATE_LIMIT_PER_HOUR=5
SCAN_TARGET_LIMIT_PER_HOUR=10
MAX_CONCURRENT_SCANS=4
REPORT_RETENTION_DAYS=90

# Not used yet (accounts/billing are a later milestone)
# SESSION_SECRET=at-least-32-random-characters-here
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
