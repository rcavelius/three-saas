# SiteProof environment. Copy to .env.local for development. Never commit real values.

# Public base URL (links in emails, CSRF origin checks, Stripe return URLs, crawler user agent)
APP_URL=http://localhost:3001

# pglite:./.data/siteproof (local, no Docker), pglite:memory (tests) or postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=pglite:./.data/siteproof

# Required in production (>= 32 random chars). Development uses a built-in placeholder when unset.
# SESSION_SECRET=
# Bearer secret for POST /api/cron/tick (>= 16 chars; 32+ recommended)
# CRON_SECRET=
# Optional separate secret for the detailed /api/health report (defaults to CRON_SECRET)
# HEALTH_DETAILS_SECRET=

# Which proxy header carries the client IP: fly | cloudflare | render | xff:<n> | none
TRUSTED_PROXY=none

# 1 = tick the job scheduler every 60 s in this process (set on Fly)
# RUN_SCHEDULER=1

# Billing (test mode until the owner authorizes live billing). Without these, checkout answers 503.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_LIVE_MODE_AUTHORIZED=   (owner only)

# Email. Without RESEND_API_KEY emails stay in the ops_email_outbox table (status "logged").
# RESEND_API_KEY=
# EMAIL_FROM=SiteProof <hello@mail.example.com>
# SUPPORT_EMAIL=help@example.com
# OWNER_ALERT_EMAIL=owner@example.com
# UPTIME_URLS=https://example.com/api/health

# Abuse limits for anonymous scans
SCAN_RATE_LIMIT_PER_HOUR=5
SCAN_TARGET_LIMIT_PER_HOUR=10
MAX_CONCURRENT_SCANS=4
REPORT_RETENTION_DAYS=90

# Monitoring politeness across all customers
MONITOR_GLOBAL_CONCURRENCY=2
MONITOR_HOST_SCANS_PER_HOUR=4
