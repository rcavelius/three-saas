# DataPolish server configuration. Copy to .env.local for development (never commit it).
# The cleaner itself needs none of this: files are processed in the browser and never uploaded.
# The database holds accounts, billing, ops data and saved workflows only.

APP_URL=http://localhost:3002
# Default when unset: pglite:./.data/datapolish (embedded Postgres in a local folder, no Docker needed).
# Production: postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=pglite:./.data/datapolish
# At least 32 random characters (openssl rand -base64 48). Required in production.
SESSION_SECRET=
# Bearer secret for /api/cron/tick and detailed /api/health (at least 16 characters).
CRON_SECRET=
# fly | cloudflare | render | xff:<n> | none   (which header carries the real client IP)
TRUSTED_PROXY=none
# 1 = run the job scheduler inside the server process (every 60 s).
RUN_SCHEDULER=

# Billing (optional). Without a key the app runs on the free plan and checkout says billing is not configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only the owner sets this, after Stripe account verification, to allow sk_live_ keys.
# STRIPE_LIVE_MODE_AUTHORIZED=true

# Email (optional). Without RESEND_API_KEY emails are only written to the ops_email_outbox table.
RESEND_API_KEY=
EMAIL_FROM="DataPolish <hello@example.com>"
OWNER_ALERT_EMAIL=
SUPPORT_EMAIL=
# Local development only (ignored unless APP_URL is localhost and RESEND_API_KEY is unset):
# also write every email as a .txt file here, so verification links can be clicked.
DEV_MAIL_DIR=./.data/mail
