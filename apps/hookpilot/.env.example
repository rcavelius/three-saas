# HookPilot local configuration. Copy to .env.local; every value has a safe local default.

# Public origin of the app. Used for capture URLs and the Origin (CSRF) check on mutating API calls.
APP_URL=http://localhost:3003

# pglite:./.data/hookpilot (default, no Docker), pglite:memory, or postgres://user:pass@host:5432/db
DATABASE_URL=pglite:./.data/hookpilot
DATABASE_POOL_MAX=5

# Bearer secret for GET/POST /api/cron/cleanup (>= 16 chars). Unset = cleanup route disabled (503).
CRON_SECRET=

# Shared base config (packages/config). Not used by HookPilot features yet, reserved for accounts.
SESSION_SECRET=change-me-to-a-random-string-of-32-plus-chars

# debug | info (default)
LOG_LEVEL=info
