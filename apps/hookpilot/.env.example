# HookPilot configuration. Copy to .env.local; every value has a safe local default unless marked required.

# Public origin of the app: capture URLs, email links, CSRF Origin checks, Stripe return URLs. (required in production)
APP_URL=http://localhost:3003

# pglite:./.data/hookpilot (default, no Docker), pglite:memory, or postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=pglite:./.data/hookpilot
DATABASE_POOL_MAX=5

# >= 32 random characters (openssl rand -base64 48). Required in production; dev falls back to an insecure constant.
SESSION_SECRET=

# Client IP source for every rate limit: fly | cloudflare | render | xff:<n> | none (default; all clients share one bucket)
TRUSTED_PROXY=none

# Bearer secret (>= 16 chars) for /api/cron/tick. Unset = route answers 503.
CRON_SECRET=
# Run the in-process scheduler (60 s tick): retention, plan enforcement, replay retries, emails, billing reconcile.
RUN_SCHEDULER=0
# Bearer secret for the detailed /api/health report.
HEALTH_DETAILS_SECRET=

# Billing (Stripe). Without STRIPE_SECRET_KEY: pricing renders, checkout answers 503, every workspace is on Free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only the owner sets this, and only after Stripe account verification.
STRIPE_LIVE_MODE_AUTHORIZED=

# Email. Without RESEND_API_KEY emails are written to the ops_email_outbox table only (status "logged").
RESEND_API_KEY=
EMAIL_FROM=HookPilot <noreply@example.com>
OWNER_ALERT_EMAIL=

# Help center + support assistant. Without ANTHROPIC_API_KEY the chat shows matching help articles
# and the ticket form; everything else works. Spend is capped per month (and per day = 1/20 of it).
ANTHROPIC_API_KEY=
# SUPPORT_AI_MODEL=claude-haiku-5-5
SUPPORT_AI_MONTHLY_BUDGET_CENTS=500
# SUPPORT_AI_DAILY_BUDGET_CENTS=25
# Escalated tickets (security, legal, refunds/disputes, abuse, data requests) go here; defaults to OWNER_ALERT_EMAIL
SUPPORT_OPERATOR_EMAIL=

# Extra hostnames replay must never target (comma separated). The APP_URL host is always included.
HP_SELF_HOSTS=
# Total stored captured requests before a usage incident is raised (default 2000000).
HP_STORED_ROWS_CEILING=

# debug | info (default)
LOG_LEVEL=info
