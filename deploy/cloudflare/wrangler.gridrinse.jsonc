// GridRinse on Cloudflare: Worker (edge, gate, cron) + one Container running the app image.
// Secrets (wrangler secret bulk, from the WORKER_SECRETS_GRIDRINSE GitHub secret): DATABASE_URL, SESSION_SECRET,
// CRON_SECRET, HEALTH_DETAILS_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY,
// OWNER_ALERT_EMAIL, STAGING_PASSWORD (remove it to make the site public).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gridrinse",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "gridrinse.com", "custom_domain": true },
    { "pattern": "www.gridrinse.com", "custom_domain": true }
  ],
  "vars": {
    "APP_NAME": "GridRinse",
    "APP_URL": "https://gridrinse.com",
    "LEGAL_ENTITY": "Media Masters LLC",
    "LEGAL_ADDRESS": "37837 Fenwick Circle, Selbyville, DE 19975, United States",
    "LEGAL_JURISDICTION": "the State of Delaware, USA",
    "LEGAL_EFFECTIVE": "2026-11-17",
    "LEGAL_APPROVED": "1",
    "STRIPE_AUTOMATIC_TAX": "1",
    "EMAIL_FROM": "GridRinse <hello@gridrinse.com>",
    "SUPPORT_EMAIL": "support@gridrinse.com",
    "ABUSE_EMAIL": "abuse@gridrinse.com",
    "GATE_EXEMPT": "/api/billing/webhook,/api/health,/api/cron/",
    "IDLE_MINUTES": "10",
    "TRUSTED_PROXY": "cloudflare",
    "RUN_SCHEDULER": "1",
    "REQUIRE_POSTGRES": "1",
    "DATABASE_POOL_MAX": "5",
    "EMAIL_RELAY_URL": "https://gridrinse.com/__edge/email"
  },
  "triggers": { "crons": ["*/30 * * * *"] },
  "containers": [
    {
      "class_name": "AppContainer",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "image_vars": { "APP": "gridrinse" },
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "AppContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppContainer"] }],
  "send_email": [{ "name": "EMAIL" }],
  // Private store of the paid spreadsheet-template files (served only through signed links; see src/index.ts).
  // KV, not R2: R2 is not enabled on this Cloudflare account. Upload with scripts/templates/upload-template-files.mjs.
  "kv_namespaces": [{ "binding": "TEMPLATE_FILES", "id": "e02eb37ac0634cdeac3491e95c3b70bd" }],
  "observability": { "enabled": true }
}
