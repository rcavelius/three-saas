// WebhookTrail on Cloudflare: Worker (edge, gate, cron) + one Container running the app image.
// Capture URLs (/h/...) are exempt from the gate: senders such as Stripe or GitHub cannot log in.
// Secrets come from the WORKER_SECRETS_WEBHOOKTRAIL GitHub secret (see wrangler.gridrinse.jsonc for the list).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webhooktrail",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "webhooktrail.com", "custom_domain": true },
    { "pattern": "www.webhooktrail.com", "custom_domain": true }
  ],
  "vars": {
    "APP_NAME": "WebhookTrail",
    "APP_URL": "https://webhooktrail.com",
    "EMAIL_FROM": "WebhookTrail <hello@webhooktrail.com>",
    "SUPPORT_EMAIL": "support@webhooktrail.com",
    "GATE_EXEMPT": "/api/billing/webhook,/api/health,/api/cron/,/h/",
    "IDLE_MINUTES": "10",
    "TRUSTED_PROXY": "cloudflare",
    "RUN_SCHEDULER": "1",
    "REQUIRE_POSTGRES": "1",
    "DATABASE_POOL_MAX": "5"
  },
  "triggers": { "crons": ["*/30 * * * *"] },
  "containers": [
    {
      "class_name": "AppContainer",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "image_vars": { "APP": "webhooktrail" },
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "AppContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppContainer"] }],
  "observability": { "enabled": true }
}
