// ChangeKite on Cloudflare: Worker (edge, gate, cron) + one Container running the app image.
// Secrets come from the WORKER_SECRETS_CHANGEKITE GitHub secret (see wrangler.gridrinse.jsonc for the list).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "changekite",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "changekite.com", "custom_domain": true },
    { "pattern": "www.changekite.com", "custom_domain": true }
  ],
  "vars": {
    "APP_NAME": "ChangeKite",
    "APP_URL": "https://changekite.com",
    "EMAIL_FROM": "ChangeKite <hello@changekite.com>",
    "SUPPORT_EMAIL": "support@changekite.com",
    "GATE_EXEMPT": "/api/billing/webhook,/api/health,/api/cron/",
    "IDLE_MINUTES": "10",
    "TRUSTED_PROXY": "cloudflare",
    "RUN_SCHEDULER": "1",
    "REQUIRE_POSTGRES": "1",
    "DATABASE_POOL_MAX": "5"
  },
  "triggers": { "crons": ["*/30 * * * *"] },
  "containers": [
    {
      "class_name": "AppContainer",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "image_vars": { "APP": "changekite" },
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "AppContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppContainer"] }],
  "observability": { "enabled": true }
}
